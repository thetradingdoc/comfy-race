# Server environment examples. No real credentials belong in Git.
# Copy to ignored .env.local. The launcher loads .env.local; exported values win.
HOST=0.0.0.0
PORT=8093
MATRIX_RACE_MAX_PLAYERS=2
MATRIX_FRAME_WIDTH=800
MATRIX_FRAME_HEIGHT=450
MATRIX_FRAME_FPS=24
# Comfy Cloud workflow jobs/story authoring. Separate from the live renderer.
COMFY_BASE_URL=https://cloud.comfy.org
COMFY_API_KEY=
# Optional later: compatible running ComfyStream origin, not a queued Cloud API.
COMFY_RACE_GPU_URL=
COMFY_RACE_GPU_TOKEN=
COMFY_RACE_OPERATOR_TOKEN=
