# Backend-only development configuration. Never put a real key in this file.
# Copy to .env.local and edit that ignored local file.
COMFY_API_KEY=
COMFY_BASE_URL=https://cloud.comfy.org
# Subscription-free alternative after installing local ComfyUI + comfy-api-proxy:
# COMFY_BASE_URL=http://127.0.0.1:8189
# The loopback proxy requires no API key by default; suitable compute is still needed.

# Configuration contract only: application loading/integration is not implemented yet.
# The Cloud workflow client must receive the key explicitly from our backend.
